# Public browser configuration only. npm run db:start writes local values to .env.local.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Copy the local anon/publishable key from your Supabase instance; never use a service-role key here.
VITE_SUPABASE_ANON_KEY=
# Optional: a real support inbox. The Podpora row in the profile appears only when it is set.
VITE_SUPPORT_EMAIL=
# Optional: booking notifications (bell, settings, Web Push). Needs the notification migrations and the
# notification-delivery function. Keep false where they are not deployed.
VITE_NOTIFICATIONS_ENABLED=false
# Public VAPID key for Web Push. The private key lives only in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=
